# Lokalna konfiguracja
.env
*.env
game-path.env
local.config.*

# Paczki i buildy
*.zip
*.7z
*.rar
*.tar
*.tar.gz
dist/
build/
backup/

# Gotowy ZIP release (payload spakowany razem z instalatorem _Installers/) -
# publikuj przez GitHub Releases, nie przez git
_Patches/*
!_Patches/README.md

# Payload patcha wewnatrz _Installers/ (duze pliki binarne gry) - publikowany
# jako czesc ZIP-a z Releases, nie commitowany do gita
_Installers/payload/*
!_Installers/payload/.gitkeep

# Tymczasowe pliki instalatorów
_Installers/**/backup/
_Installers/**/tmp/

# System
.DS_Store
Thumbs.db

# Python / narzędzia lokalne
__pycache__/
*.pyc
.venv/
venv/
